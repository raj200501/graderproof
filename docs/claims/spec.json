  "figures": {
    "e0-headline": {
      "title": "E0 tool validity on planted ground truth (synthetic toybench)",
      "alt": "Recall and precision of graderproof on the planted toybench weaknesses, with 95% CI bootstrap intervals",
      "axis_label": "share of tasks",
      "domain": [
        0,
        1
      ],
      "tick_format": "{:.0%}",
      "bars": [
        {
          "label": "Recall",
          "value": "e0.recall",
          "lo": "e0.recall_lo",
          "hi": "e0.recall_hi"
        },
        {
          "label": "Precision",
          "value": "e0.precision",
          "lo": "e0.precision_lo",
          "hi": "e0.precision_hi"
        },
        {
          "label": "Precision before adjudication",
          "value": "e0.precision_raw",
          "lo": "e0.precision_raw_lo",
          "hi": "e0.precision_raw_hi"
        }
      ]
    },
    "e0-by-type": {
      "title": "Planted weaknesses detected, by type (synthetic toybench)",
      "alt": "Share of planted toybench weaknesses that graderproof detected, for each weakness type",
      "axis_label": "share detected",
      "domain": [
        0,
        1
      ],
      "tick_format": "{:.0%}",
      "bars": [
        {
          "label": "presence-not-content",
          "value": "e0.type.presence-not-content.rate"
        },
        {
          "label": "exit-code-only",
          "value": "e0.type.exit-code-only.rate"
        },
        {
