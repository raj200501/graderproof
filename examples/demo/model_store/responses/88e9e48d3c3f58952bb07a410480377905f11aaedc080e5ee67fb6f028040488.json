  "items": {
    "demo:classify": {
      "requirements": [
        {
          "id": "R1",
          "text": "Write `classify.py` containing a function `classify(n)`.",
          "checks": [
            {"type": "file_exists", "path": "classify.py"},
            {"type": "file_regex", "path": "classify.py", "pattern": "def\\s+classify\\s*\\(\\s*n\\s*\\)"}
          ]
        },
        {
          "id": "R2",
          "text": "`classify(n)` returns \"fizzbuzz\" if `n` is divisible by both 3 and 5.",
          "checks": [
            {"type": "call", "probe": {"function": "classify", "args": [15], "kwargs": {}}, "equals": "fizzbuzz"},
            {"type": "call", "probe": {"function": "classify", "args": [30], "kwargs": {}}, "equals": "fizzbuzz"},
            {"type": "call", "probe": {"function": "classify", "args": [45], "kwargs": {}}, "equals": "fizzbuzz"},
            {"type": "call", "probe": {"function": "classify", "args": [90], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R3",
          "text": "`classify(n)` returns \"fizz\" if `n` is divisible by 3 only.",
          "checks": [
            {"type": "call", "probe": {"function": "classify", "args": [3], "kwargs": {}}, "equals": "fizz"},
            {"type": "call", "probe": {"function": "classify", "args": [9], "kwargs": {}}, "equals": "fizz"},
            {"type": "call", "probe": {"function": "classify", "args": [21], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "classify", "args": [99], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R4",
          "text": "`classify(n)` returns \"buzz\" if `n` is divisible by 5 only.",
          "checks": [
            {"type": "call", "probe": {"function": "classify", "args": [5], "kwargs": {}}, "equals": "buzz"},
            {"type": "call", "probe": {"function": "classify", "args": [10], "kwargs": {}}, "equals": "buzz"},
            {"type": "call", "probe": {"function": "classify", "args": [25], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "classify", "args": [100], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R5",
          "text": "Otherwise `classify(n)` returns the decimal string of `n` (for example `classify(7)` returns \"7\").",
          "checks": [
            {"type": "call", "probe": {"function": "classify", "args": [7], "kwargs": {}}, "equals": "7"},
            {"type": "call", "probe": {"function": "classify", "args": [1], "kwargs": {}}, "equals": "1"},
            {"type": "call", "probe": {"function": "classify", "args": [2], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "classify", "args": [14], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "classify", "args": [101], "kwargs": {}}, "matches_reference": true}
          ]
        }
      ]
    },
    "demo:greeting": {
      "requirements": [
        {
          "id": "R1",
          "text": "Create `hello.txt`.",
          "checks": [
            {"type": "file_exists", "path": "hello.txt"}
          ]
        },
        {
          "id": "R2",
          "text": "`hello.txt` has `Hello, graderproof!` as its only line.",
          "checks": [
            {"type": "file_equals", "path": "hello.txt", "text": "Hello, graderproof!", "normalize": "strip"},
            {"type": "file_lines", "path": "hello.txt", "count": 1}
          ]
        },
        {
          "id": "R3",
          "text": "Create `count.txt`.",
          "checks": [
            {"type": "file_exists", "path": "count.txt"}
          ]
        },
        {
          "id": "R4",
          "text": "`count.txt` contains the number of characters in the greeting, not counting the newline (19).",
          "checks": [
            {"type": "file_equals", "path": "count.txt", "text": "19", "normalize": "strip"}
          ]
        }
      ]
    },
    "demo:refund": {
      "requirements": [
        {
          "id": "R1",
          "text": "Look up the order with `get_order` (order `A17`).",
          "checks": [
            {"type": "trajectory_includes", "tool": "get_order", "args": {"order_id": "A17"}}
          ]
        },
        {
          "id": "R2",
          "text": "Confirm the refund amount with the customer using `confirm_with_user`.",
          "checks": [
            {"type": "trajectory_includes", "tool": "confirm_with_user", "args": {}}
          ]
        },
        {
          "id": "R3",
          "text": "Issue a full refund of the order total with `refund` (order `A17`, amount 40, the order total).",
          "checks": [
            {"type": "trajectory_includes", "tool": "refund", "args": {"order_id": "A17", "amount": 40}},
            {"type": "state_equals", "pointer": "/orders/A17/refunded", "equals": 40}
          ]
        },
        {
          "id": "R4",
          "text": "Then send the customer a receipt with `send_receipt`.",
          "checks": [
            {"type": "trajectory_includes", "tool": "send_receipt", "args": {"order_id": "A17"}},
            {"type": "state_equals", "pointer": "/receipts/0", "equals": "A17"}
          ]
        },
        {
          "id": "R5",
          "text": "Before issuing any refund, confirm the refund amount with the customer: `confirm_with_user` must come before `refund`.",
          "checks": [
            {
              "type": "trajectory_before",
              "first": {"tool": "confirm_with_user", "args": {}},
              "then": {"tool": "refund", "args": {"order_id": "A17"}}
            }
          ]
        },
        {
          "id": "R6",
          "text": "Step order: the order lookup with `get_order` comes before the confirmation and before the refund.",
          "checks": [
            {
              "type": "trajectory_before",
              "first": {"tool": "get_order", "args": {"order_id": "A17"}},
              "then": {"tool": "confirm_with_user", "args": {}}
            },
            {
              "type": "trajectory_before",
              "first": {"tool": "get_order", "args": {"order_id": "A17"}},
              "then": {"tool": "refund", "args": {"order_id": "A17"}}
            }
          ]
        },
        {
          "id": "R7",
          "text": "Then send the receipt: `send_receipt` comes after the refund has been issued.",
          "checks": [
            {
              "type": "trajectory_before",
              "first": {"tool": "refund", "args": {"order_id": "A17"}},
              "then": {"tool": "send_receipt", "args": {"order_id": "A17"}}
            }
          ]
        }
      ]
    },
    "demo:status-json": {
      "requirements": [
        {
          "id": "R1",
          "text": "Print a JSON object to standard output.",
          "checks": [
            {"type": "stdout_regex", "pattern": "^\\s*\\{[\\s\\S]*\\}\\s*$"},
            {"type": "stdout_json", "pointer": "/status", "equals": "ok"}
          ]
        },
        {
          "id": "R2",
          "text": "The `\"status\"` field is set to the string `\"ok\"`.",
          "checks": [
            {"type": "stdout_json", "pointer": "/status", "equals": "ok"}
          ]
        },
        {
          "id": "R3",
          "text": "The `\"items\"` field is set to the number of lines in `data.txt` (4).",
          "checks": [
            {"type": "stdout_json", "pointer": "/items", "equals": 4}
          ]
        }
      ]
    },
    "demo:word-stats": {
      "requirements": [
        {
          "id": "R1",
          "text": "Write `stats.json` containing a JSON object.",
          "checks": [
            {"type": "file_exists", "path": "stats.json"},
            {"type": "file_regex", "path": "stats.json", "pattern": "^\\s*\\{[\\s\\S]*\\}\\s*$"}
          ]
        },
        {
          "id": "R2",
          "text": "`lines` is an integer field: the number of lines in `input.txt` (3).",
          "checks": [
            {"type": "file_json", "path": "stats.json", "pointer": "/lines", "equals": 3},
            {"type": "file_regex", "path": "stats.json", "pattern": "\"lines\"\\s*:\\s*\\d+\\s*[,}]"}
          ]
        },
        {
          "id": "R3",
          "text": "`words` is an integer field: the number of whitespace-separated words in `input.txt` (9).",
          "checks": [
            {"type": "file_json", "path": "stats.json", "pointer": "/words", "equals": 9},
            {"type": "file_regex", "path": "stats.json", "pattern": "\"words\"\\s*:\\s*\\d+\\s*[,}]"}
          ]
        }
      ]
    }
  },
