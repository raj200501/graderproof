    "dc815a91feef86df1cd6f77ded47cf5831c6b2d551792f56f8e503eaa185fc3f": {
      "requirements": [
        {"id": "R1", "text": "Write a Python module wrap.py", "checks": [{"type": "file_exists", "path": "wrap.py"}]},
        {"id": "R2", "text": "Fill lines greedily with single spaces, each line at most width characters", "checks": [
          {"type": "call", "probe": {"function": "wrap", "args": ["the quick brown fox jumps", 10], "kwargs": {}}, "equals": ["the quick", "brown fox", "jumps"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["aaa bbb ccc", 7], "kwargs": {}}, "equals": ["aaa bbb", "ccc"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["aaa bbb ccc", 11], "kwargs": {}}, "equals": ["aaa bbb ccc"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["aaa bbb ccc", 6], "kwargs": {}}, "equals": ["aaa", "bbb", "ccc"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["a b c d e f", 3], "kwargs": {}}, "equals": ["a b", "c d", "e f"]}
        ]},
        {"id": "R3", "text": "Words are maximal runs of non-whitespace; runs of any whitespace separate words and are collapsed to single spaces", "checks": [
          {"type": "call", "probe": {"function": "wrap", "args": ["  hello   world \n again\tx ", 20], "kwargs": {}}, "equals": ["hello world again x"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["one\ntwo\n\nthree", 7], "kwargs": {}}, "equals": ["one two", "three"]}
        ]},
        {"id": "R4", "text": "A word longer than width is put on a line of its own, unbroken", "checks": [
          {"type": "call", "probe": {"function": "wrap", "args": ["a extraordinarily b", 5], "kwargs": {}}, "equals": ["a", "extraordinarily", "b"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["abcdefgh", 3], "kwargs": {}}, "equals": ["abcdefgh"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["ab cdefgh ij kl", 4], "kwargs": {}}, "equals": ["ab", "cdefgh", "ij", "kl"]}
        ]},
        {"id": "R5", "text": "No line has leading or trailing spaces; return a list of lines", "checks": [
          {"type": "call", "probe": {"function": "wrap", "args": ["  lead and trail  ", 8], "kwargs": {}}, "equals": ["lead and", "trail"]},
          {"type": "call", "probe": {"function": "wrap", "args": ["x", 1], "kwargs": {}}, "equals": ["x"]}
        ]},
        {"id": "R6", "text": "If text contains no words, return []", "checks": [
          {"type": "call", "probe": {"function": "wrap", "args": ["", 10], "kwargs": {}}, "equals": []},
          {"type": "call", "probe": {"function": "wrap", "args": ["   \n\t ", 10], "kwargs": {}}, "equals": []}
        ]},
        {"id": "R7", "text": "Boundary behaviour on further inputs agrees with the reference", "checks": [
          {"type": "call", "probe": {"function": "wrap", "args": ["lorem ipsum dolor sit amet consectetur adipiscing elit", 12], "kwargs": {}}, "matches_reference": true},
          {"type": "call", "probe": {"function": "wrap", "args": ["ab cd ef gh", 5], "kwargs": {}}, "matches_reference": true}
        ]}
      ]
    },
