    "9563c4f6af36ba5193a9d30376cfbc095079db9fb3f5bf59e2732a372848039f": {
      "requirements": [
        {
          "id": "R1",
          "text": "Provide a module `luhn.py` with a function `luhn_valid(number)`.",
          "checks": [
            {"type": "file_exists", "path": "luhn.py"}
          ]
        },
        {
          "id": "R2",
          "text": "Return True for a string of 12 to 19 ASCII digits that passes the Luhn checksum.",
          "checks": [
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111111111111111"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["5500005555555559"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4539148803436467"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["378282246310005"], "kwargs": {}}, "equals": true}
          ]
        },
        {
          "id": "R3",
          "text": "Return False when the checksum fails (the sum is not divisible by 10).",
          "checks": [
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111111111111112"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["5500005555555558"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4539148803436468"], "kwargs": {}}, "equals": false}
          ]
        },
        {
          "id": "R4",
          "text": "Spaces and dashes are allowed as group separators and are removed first.",
          "checks": [
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111 1111 1111 1111"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111-1111-1111-1111"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111 1111-1111 1111"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": [" 4111111111111111 "], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111 1111 1111 1112"], "kwargs": {}}, "equals": false}
          ]
        },
        {
          "id": "R5",
          "text": "The digit count must be 12 to 19 after removing separators; fewer than 12 or more than 19 digits give False.",
          "checks": [
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["0000000000000"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["000000000000"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["00000000000"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["0000000000000000000"], "kwargs": {}}, "equals": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["00000000000000000000"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["0"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111111111111111111"], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["41111111111"], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R6",
          "text": "What remains must consist only of ASCII digits; any other character gives False, including empty input, and no exception is raised for a string argument.",
          "checks": [
            {"type": "call", "probe": {"function": "luhn_valid", "args": [""], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": [" - "], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["abcd efgh ijkl mnop"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111111111111111x"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111.1111.1111.1111"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111_1111_1111_1111"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["4111\t1111\t1111\t1111"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["４１１１１１１１１１１１１１１１"], "kwargs": {}}, "equals": false},
            {"type": "call", "probe": {"function": "luhn_valid", "args": ["+4111111111111111"], "kwargs": {}}, "equals": false}
          ]
        },
        {
          "id": "R7",
          "text": "Luhn doubling starts at the second digit from the right and subtracts 9 from results above 9.",
