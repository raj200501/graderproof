  "items": {
    "80a983f5c4a87e51d0d042dd79d60e3ff45ea72d24564a3fbf8904af746bbd56": {
      "requirements": [
        {
          "id": "R1",
          "text": "Approve LR-301 with approve_request because E-77 has balance 6, at least the 4 days requested.",
          "checks": [
            {"type": "trajectory_includes", "tool": "approve_request", "args": {"request_id": "LR-301"}},
            {"type": "state_equals", "pointer": "/requests/LR-301/status", "equals": "approved"}
          ]
        },
        {
          "id": "R2",
          "text": "Reject LR-302 with reject_request and the reason `insufficient balance`, because E-81 has balance 2, less than the 3 days requested.",
          "checks": [
            {"type": "trajectory_includes", "tool": "reject_request", "args": {"request_id": "LR-302", "reason": "insufficient balance"}},
            {"type": "state_equals", "pointer": "/requests/LR-302/status", "equals": "rejected"},
            {"type": "state_equals", "pointer": "/requests/LR-302/reason", "equals": "insufficient balance"},
            {"type": "trajectory_excludes", "tool": "approve_request", "args": {"request_id": "LR-302"}}
          ]
        },
        {
          "id": "R3",
          "text": "Approve LR-303 because E-90 has balance 10, exactly the 10 days requested (balance at least the days requested).",
          "checks": [
            {"type": "trajectory_includes", "tool": "approve_request", "args": {"request_id": "LR-303"}},
            {"type": "state_equals", "pointer": "/requests/LR-303/status", "equals": "approved"},
            {"type": "trajectory_excludes", "tool": "reject_request", "args": {"request_id": "LR-303"}}
          ]
        },
        {
          "id": "R4",
          "text": "Approving deducts the days from the balance; balances end at E-77 2, E-81 2, E-90 0, so each request is approved only once and rejected requests deduct nothing.",
          "checks": [
            {"type": "state_equals", "pointer": "/employees/E-77/balance_days", "equals": 2},
            {"type": "state_equals", "pointer": "/employees/E-81/balance_days", "equals": 2},
            {"type": "state_equals", "pointer": "/employees/E-90/balance_days", "equals": 0}
          ]
        },
        {
          "id": "R5",
          "text": "Do not change requests that are not pending (LR-288 and LR-298 keep their status and reason).",
          "checks": [
            {"type": "state_equals", "pointer": "/requests/LR-288/status", "equals": "rejected"},
            {"type": "state_equals", "pointer": "/requests/LR-288/reason", "equals": "blackout period"},
            {"type": "state_equals", "pointer": "/requests/LR-298/status", "equals": "approved"},
            {"type": "state_equals", "pointer": "/requests/LR-298/reason", "equals": null},
            {"type": "trajectory_excludes", "tool": "approve_request", "args": {"request_id": "LR-288"}},
            {"type": "trajectory_excludes", "tool": "reject_request", "args": {"request_id": "LR-288"}},
            {"type": "trajectory_excludes", "tool": "approve_request", "args": {"request_id": "LR-298"}},
            {"type": "trajectory_excludes", "tool": "reject_request", "args": {"request_id": "LR-298"}}
          ]
        },
        {
          "id": "R6",
          "text": "Process every pending request: the final state matches the reference state.",
          "checks": [
            {"type": "same_as_reference", "target": "state", "normalize": "none"}
          ]
        }
      ]
    },
    "814b9f61286022e5d797009583de535c84584ab1c01ebb4b453ffe45eea486df": {
      "requirements": [
        {
          "id": "R1",
          "text": "In the `[database]` section, change `pool_size = 5` to `pool_size = 20`.",
          "checks": [
            {"type": "file_contains", "path": "app.ini", "text": "[database]\nurl = postgres://booking@db.internal/booking\npool_size = 20\n; seconds"}
          ]
        },
        {
          "id": "R2",
          "text": "In the `[cache]` section, insert `timeout = 15` directly after the line `url = redis://cache.internal:6379/0`.",
          "checks": [
            {"type": "file_contains", "path": "app.ini", "text": "url = redis://cache.internal:6379/0\ntimeout = 15\n"}
          ]
        },
        {
          "id": "R3",
          "text": "Every other line, including the `[reports]` `pool_size = 5`, comments, blank lines and their order, stays exactly as it was.",
          "checks": [
            {"type": "file_contains", "path": "app.ini", "text": "[reports]\npool_size = 5\n"},
            {"type": "file_contains", "path": "app.ini", "text": "; Booking service configuration\n[server]\nhost = 0.0.0.0\nport = 8080\n\n[database]"},
            {"type": "file_equals", "path": "app.ini", "text": "; Booking service configuration\n[server]\nhost = 0.0.0.0\nport = 8080\n\n[database]\nurl = postgres://booking@db.internal/booking\npool_size = 20\n; seconds\nconnect_timeout = 10\n\n[cache]\nbackend = redis\nurl = redis://cache.internal:6379/0\ntimeout = 15\n\n[reports]\npool_size = 5\n", "normalize": "none"}
          ]
        },
        {
          "id": "R4",
          "text": "The file must still end with a newline (exactly one, as in the original).",
          "checks": [
            {"type": "file_regex", "path": "app.ini", "pattern": "pool_size = 5\\n\\Z"}
          ]
        }
      ]
    },
