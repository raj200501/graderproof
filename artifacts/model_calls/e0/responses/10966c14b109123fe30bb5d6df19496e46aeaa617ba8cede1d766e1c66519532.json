    "8581102271bb6f6ed0740466a4d869df36f4d202ea111145e69d95482e9acf50": {
      "requirements": [
        {
          "id": "R1",
          "text": "Provide a module `urlquery.py`.",
          "checks": [
            {"type": "file_exists", "path": "urlquery.py"}
          ]
        },
        {
          "id": "R2",
          "text": "Pairs are separated by `&`; a single leading `?` is ignored; keys and values are decoded (`+` is a space, `%XX` is a UTF-8 byte); example from the text.",
          "checks": [
            {"type": "call", "probe": {"function": "parse_query", "args": ["?q=red+shoes&size=42&sort=price%2Basc"], "kwargs": {}}, "equals": {"q": "red shoes", "size": "42", "sort": "price+asc"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["q=red+shoes&size=42"], "kwargs": {}}, "equals": {"q": "red shoes", "size": "42"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["?a=1"], "kwargs": {}}, "equals": {"a": "1"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["??a=1"], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "parse_query", "args": ["n=%C3%A9&m=caf%C3%A9+au+lait"], "kwargs": {}}, "equals": {"n": "é", "m": "café au lait"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["k%3D+x=v%26w%2B"], "kwargs": {}}, "equals": {"k= x": "v&w+"}}
          ]
        },
        {
          "id": "R3",
          "text": "Each pair is split at the first `=`; a pair without `=` has the value empty string.",
          "checks": [
            {"type": "call", "probe": {"function": "parse_query", "args": ["a=b=c"], "kwargs": {}}, "equals": {"a": "b=c"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["debug"], "kwargs": {}}, "equals": {"debug": ""}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["debug&x=1"], "kwargs": {}}, "equals": {"debug": "", "x": "1"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["a="], "kwargs": {}}, "equals": {"a": ""}}
          ]
        },
        {
          "id": "R4",
          "text": "Empty pairs (from `&&` or a trailing `&`) are skipped; `parse_query(\"\")` returns `{}`.",
          "checks": [
            {"type": "call", "probe": {"function": "parse_query", "args": [""], "kwargs": {}}, "equals": {}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["?"], "kwargs": {}}, "equals": {}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["a=1&&b=2&"], "kwargs": {}}, "equals": {"a": "1", "b": "2"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["&&"], "kwargs": {}}, "equals": {}}
          ]
        },
        {
          "id": "R5",
          "text": "If a key appears more than once, the last value wins.",
          "checks": [
            {"type": "call", "probe": {"function": "parse_query", "args": ["a=1&a=2&a=3"], "kwargs": {}}, "equals": {"a": "3"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["a=1&b=2&a=9"], "kwargs": {}}, "equals": {"a": "9", "b": "2"}}
          ]
        },
        {
          "id": "R6",
          "text": "Return a dict mapping each decoded key to its decoded value; keys that only differ after decoding collapse.",
          "checks": [
            {"type": "call", "probe": {"function": "parse_query", "args": ["a+b=1&a%20b=2"], "kwargs": {}}, "equals": {"a b": "2"}},
            {"type": "call", "probe": {"function": "parse_query", "args": ["%E2%82%AC=%F0%9F%99%82"], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R7",
          "text": "Use only the Python standard library.",
          "checks": [
            {"type": "file_regex", "path": "urlquery.py", "pattern": "\\A(?:(?!\\b(?:import|from)\\s+(?:requests|yarl|furl|w3lib|werkzeug|django|flask|numpy|pandas)\\b)[\\s\\S])*\\Z"}
          ]
        }
      ]
    },
    "898b9d9fb49dfe27231940c78ff2cdf2342c5bf600abeca5f53713b8045e7888": {
      "requirements": [
        {
          "id": "R1",
          "text": "Provide a module `taskqueue.py` with a function `sort_tasks(tasks)`.",
          "checks": [
            {"type": "file_exists", "path": "taskqueue.py"},
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[]], "kwargs": {}}, "equals": []}
          ]
        },
        {
          "id": "R2",
          "text": "Order by priority, 1 first.",
          "checks": [
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "a", "priority": 3, "due": null}, {"title": "b", "priority": 1, "due": null}, {"title": "c", "priority": 2, "due": null}]], "kwargs": {}}, "equals": [{"title": "b", "priority": 1, "due": null}, {"title": "c", "priority": 2, "due": null}, {"title": "a", "priority": 3, "due": null}]},
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "a", "priority": 10, "due": "2026-01-01"}, {"title": "z", "priority": 2, "due": "2030-01-01"}]], "kwargs": {}}, "equals": [{"title": "z", "priority": 2, "due": "2030-01-01"}, {"title": "a", "priority": 10, "due": "2026-01-01"}]}
          ]
        },
        {
          "id": "R3",
          "text": "Within the same priority, order by due date, earliest first, with tasks without a due date after those with one.",
          "checks": [
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "a", "priority": 1, "due": null}, {"title": "b", "priority": 1, "due": "2026-05-02"}, {"title": "c", "priority": 1, "due": "2026-05-01"}]], "kwargs": {}}, "equals": [{"title": "c", "priority": 1, "due": "2026-05-01"}, {"title": "b", "priority": 1, "due": "2026-05-02"}, {"title": "a", "priority": 1, "due": null}]},
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "a", "priority": 2, "due": null}, {"title": "b", "priority": 1, "due": null}, {"title": "c", "priority": 2, "due": "2027-01-01"}]], "kwargs": {}}, "equals": [{"title": "b", "priority": 1, "due": null}, {"title": "c", "priority": 2, "due": "2027-01-01"}, {"title": "a", "priority": 2, "due": null}]}
          ]
        },
        {
          "id": "R4",
          "text": "Within the same priority and due date, order by title, alphabetical and case-sensitive.",
          "checks": [
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "b", "priority": 1, "due": null}, {"title": "B", "priority": 1, "due": null}, {"title": "a", "priority": 1, "due": null}, {"title": "A", "priority": 1, "due": null}]], "kwargs": {}}, "equals": [{"title": "A", "priority": 1, "due": null}, {"title": "B", "priority": 1, "due": null}, {"title": "a", "priority": 1, "due": null}, {"title": "b", "priority": 1, "due": null}]},
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "y", "priority": 1, "due": "2026-03-03"}, {"title": "x", "priority": 1, "due": "2026-03-03"}]], "kwargs": {}}, "equals": [{"title": "x", "priority": 1, "due": "2026-03-03"}, {"title": "y", "priority": 1, "due": "2026-03-03"}]}
          ]
        },
        {
          "id": "R5",
          "text": "Dicts may contain other keys, which must be kept.",
          "checks": [
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "b", "priority": 2, "due": null, "tag": "x", "id": 7}, {"title": "a", "priority": 1, "due": "2026-01-01", "notes": ["n1"]}]], "kwargs": {}}, "equals": [{"title": "a", "priority": 1, "due": "2026-01-01", "notes": ["n1"]}, {"title": "b", "priority": 2, "due": null, "tag": "x", "id": 7}]}
          ]
        },
        {
          "id": "R6",
          "text": "Return a new list with the same dicts; the input list and its dicts are not modified (input order stays as given).",
          "checks": [
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "b", "priority": 2, "due": "2026-02-02"}, {"title": "a", "priority": 1, "due": null}, {"title": "c", "priority": 1, "due": "2026-01-01"}, {"title": "d", "priority": 2, "due": null}]], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "sort_tasks", "args": [[{"title": "t1", "priority": 3, "due": "2026-09-09", "x": 1}, {"title": "t1", "priority": 3, "due": "2026-09-08", "x": 2}, {"title": "t0", "priority": 3, "due": null, "x": 3}]], "kwargs": {}}, "matches_reference": true}
          ]
        }
      ]
    },
    "8c3d7d63e3f17244d8e25ed2a031c0176ceeda76dc97195cbd71a862456f8be4": {
      "requirements": [
        {
          "id": "R1",
