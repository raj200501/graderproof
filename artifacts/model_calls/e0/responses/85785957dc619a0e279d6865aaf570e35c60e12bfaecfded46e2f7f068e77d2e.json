        {"id": "R2", "text": "levenshtein(a, b) returns the minimum number of single-character insertions, deletions and substitutions turning a into b (classic examples).", "checks": [
          {"type": "call", "probe": {"function": "levenshtein", "args": ["kitten", "sitting"], "kwargs": {}}, "equals": 3},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["flaw", "lawn"], "kwargs": {}}, "equals": 2},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["intention", "execution"], "kwargs": {}}, "equals": 5},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["abc", "abc"], "kwargs": {}}, "equals": 0},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["", ""], "kwargs": {}}, "equals": 0},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["abc", ""], "kwargs": {}}, "equals": 3},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["", "abcd"], "kwargs": {}}, "equals": 4},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["sunday", "saturday"], "kwargs": {}}, "equals": 3},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["Hotel Aurora", "Hotel Aurora Inn"], "kwargs": {}}, "matches_reference": true},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["gumbo", "gambol"], "kwargs": {}}, "matches_reference": true}
        ]},
        {"id": "R3", "text": "Characters are compared exactly (case-sensitive).", "checks": [
          {"type": "call", "probe": {"function": "levenshtein", "args": ["a", "A"], "kwargs": {}}, "equals": 1},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["Hilton", "hilton"], "kwargs": {}}, "equals": 1},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["HELLO", "hello"], "kwargs": {}}, "equals": 5}
        ]},
        {"id": "R4", "text": "Each Unicode code point counts as one character.", "checks": [
          {"type": "call", "probe": {"function": "levenshtein", "args": ["café", "cafe"], "kwargs": {}}, "equals": 1},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["日本語", "日本"], "kwargs": {}}, "equals": 1},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["😀a", "a"], "kwargs": {}}, "equals": 1},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["😀", "😁"], "kwargs": {}}, "equals": 1},
          {"type": "call", "probe": {"function": "levenshtein", "args": ["naïve", "naive"], "kwargs": {}}, "matches_reference": true}
        ]}
      ]
