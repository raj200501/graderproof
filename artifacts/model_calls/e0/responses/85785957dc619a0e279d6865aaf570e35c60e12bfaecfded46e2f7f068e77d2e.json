    "055f4b5d87202dff228c7e13936300837aa2c4b828aa8332482510cb1ac698ff": {
      "requirements": [
        {"id": "R1", "text": "Write `usage.csv`.", "checks": [{"type": "file_exists", "path": "usage.csv"}]},
        {"id": "R2", "text": "The first row of usage.csv is the header `meter,kwh`.", "checks": [{"type": "file_regex", "path": "usage.csv", "pattern": "\\Ameter,kwh\\r?\\n"}]},
        {"id": "R3", "text": "One row per meter that appears in readings.csv (four meters) after the header.", "checks": [{"type": "file_lines", "path": "usage.csv", "count": 5}]},
        {"id": "R4", "text": "Rows are sorted by meter ID and kwh is the reading on the latest date minus the reading on the earliest date, as an integer (MTR-01 395, MTR-02 292, MTR-03 775, MTR-04 1118).", "checks": [{"type": "file_equals", "path": "usage.csv", "text": "meter,kwh\nMTR-01,395\nMTR-02,292\nMTR-03,775\nMTR-04,1118\n", "normalize": "strip"}]}
