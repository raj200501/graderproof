        {"id": "R5", "text": "Issue no other refunds.", "checks": [
          {"type": "trajectory_excludes", "tool": "issue_refund", "args": {"sub_id": "SUB-3390"}},
          {"type": "state_equals", "pointer": "/refunds", "equals": [{"amount_cents": 700, "sub_id": "SUB-3381"}]}
