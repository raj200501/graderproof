          {"type": "state_equals", "pointer": "/events/EV-302/start", "equals": "14:00"},
          {"type": "state_equals", "pointer": "/events/EV-302/end", "equals": "14:30"}
        ]},
        {"id": "R3", "text": "Invite exactly Lena Ortiz, Sam Cho and Priya Nair (their listed emails) and nobody else.", "checks": [
          {"type": "state_equals", "pointer": "/events/EV-302/attendees", "equals": ["lena.ortiz@example.com", "sam.cho@example.com", "priya.nair@example.com"]},
          {"type": "trajectory_includes", "tool": "create_event", "args": {"attendees": ["lena.ortiz@example.com", "sam.cho@example.com", "priya.nair@example.com"]}}
        ]},
        {"id": "R4", "text": "Do not change any existing event.", "checks": [
