    "7100e86dcce06899e9d740a17d965e4768f5b3a2fd2c5ba1fdf90b62555ac4ac": {
      "requirements": [
        {"id": "R1", "text": "Create an executable bash script at `bin/countlines` (create the `bin/` directory).", "checks": [
          {"type": "file_exists", "path": "bin/countlines"},
          {"type": "exit_code", "code": 0}
        ]},
        {"id": "R2", "text": "The script must start with `#!/usr/bin/env bash` or `#!/bin/bash`.", "checks": [
          {"type": "file_regex", "path": "bin/countlines", "pattern": "\\A#!(/usr/bin/env bash|/bin/bash)[ \\t]*\\r?\\n"}
        ]},
        {"id": "R3", "text": "Run as `bin/countlines DIR`, it takes DIR as its argument and counts lines of `.log` files directly inside DIR.", "checks": [
          {"type": "file_regex", "path": "bin/countlines", "pattern": "\\.log"},
          {"type": "file_regex", "path": "bin/countlines", "pattern": "\\$\\{?1"}
        ]},
        {"id": "R4", "text": "Count lines the way `wc -l` does (number of newline characters); print the total as a plain decimal integer on one line; if DIR contains no such files, print `0`.", "checks": [
          {"type": "file_regex", "path": "bin/countlines", "pattern": "wc\\s+-l|\\bcount\\b|echo\\s+0"},
          {"type": "file_regex", "path": "bin/countlines", "pattern": "\\b0\\b"}
        ]},
        {"id": "R5", "text": "The script may use only bash and coreutils.", "checks": [
          {"type": "file_regex", "path": "bin/countlines", "pattern": "\\A(?![\\s\\S]*\\b(python3?|perl|ruby|node|awk|gawk)\\b)[\\s\\S]*\\Z"}
        ]}
      ]
    },
