    "6d616480807a0e4a20b813e7a936f76c4b4f54241a4044cc229a3a5971a46c3d": {
      "requirements": [
        {"id": "R1", "text": "Write a Python module `slug.py` with a function `slugify(title)`.", "checks": [
          {"type": "file_exists", "path": "slug.py"},
          {"type": "file_regex", "path": "slug.py", "pattern": "def\\s+slugify\\s*\\(\\s*title"}
        ]},
        {"id": "R2", "text": "Convert ASCII uppercase letters to lowercase; keep ASCII letters and digits.", "checks": [
          {"type": "call", "probe": {"function": "slugify", "args": ["ABC xyz 123"], "kwargs": {}}, "equals": "abc-xyz-123"},
          {"type": "call", "probe": {"function": "slugify", "args": ["Hello, World!"], "kwargs": {}}, "equals": "hello-world"},
          {"type": "call", "probe": {"function": "slugify", "args": ["Route66"], "kwargs": {}}, "equals": "route66"}
        ]},
        {"id": "R3", "text": "Every maximal run of other characters (spaces, punctuation, non-ASCII letters such as é) becomes a single `-`.", "checks": [
          {"type": "call", "probe": {"function": "slugify", "args": ["Caf\u00e9 au lait"], "kwargs": {}}, "equals": "caf-au-lait"},
          {"type": "call", "probe": {"function": "slugify", "args": ["a   b---c"], "kwargs": {}}, "equals": "a-b-c"},
          {"type": "call", "probe": {"function": "slugify", "args": ["na\u00efve\u00e9\u00e9test"], "kwargs": {}}, "equals": "na-ve-test"},
          {"type": "call", "probe": {"function": "slugify", "args": ["one, two; three"], "kwargs": {}}, "equals": "one-two-three"}
        ]},
        {"id": "R4", "text": "Remove any `-` at the start or end of the result.", "checks": [
          {"type": "call", "probe": {"function": "slugify", "args": ["  --Hello--  "], "kwargs": {}}, "equals": "hello"},
          {"type": "call", "probe": {"function": "slugify", "args": ["!Hi!"], "kwargs": {}}, "equals": "hi"},
          {"type": "call", "probe": {"function": "slugify", "args": ["\u00e9clair"], "kwargs": {}}, "equals": "clair"}
        ]},
        {"id": "R5", "text": "Return the slug as a string; it is \"\" when the title has no ASCII letters or digits.", "checks": [
          {"type": "call", "probe": {"function": "slugify", "args": [""], "kwargs": {}}, "equals": ""},
          {"type": "call", "probe": {"function": "slugify", "args": ["!!! ???"], "kwargs": {}}, "equals": ""},
          {"type": "call", "probe": {"function": "slugify", "args": ["\u00e9\u00e8\u00e0"], "kwargs": {}}, "equals": ""}
        ]}
      ]
    },
    "6ef5bc2ac5a70fd0a55d668a597d0a09063f9a3a3d691777e90eebc5304869ca": {
