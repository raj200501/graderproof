        {
          "id": "R2",
          "text": "Ignore blank lines and lines whose first non-space character is '#' (the commented APP_PORT=1234 line contributes nothing, and no comment header key appears).",
          "checks": [
            {"type": "file_json", "path": "config.json", "pointer": "/APP_PORT", "equals": "9090", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/APP_NAME", "equals": "booking-api", "lenient": false}
          ]
        },
        {
          "id": "R3",
          "text": "Split each line at the first '=' and remove spaces and tabs around the key and the value (so '   LOG_LEVEL = info' gives key LOG_LEVEL, value info).",
          "checks": [
            {"type": "file_json", "path": "config.json", "pointer": "/LOG_LEVEL", "equals": "info", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/EMPTY_VALUE", "equals": "", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/DATABASE_URL", "equals": "postgres://booking@db.internal:5432/booking", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/CACHE_TTL", "equals": "300 # seconds", "lenient": false}
          ]
        },
        {
          "id": "R4",
          "text": "If the value starts and ends with the same quote character (\" or '), remove that one pair of quotes; nothing else is unescaped, so inner quotes are kept.",
          "checks": [
            {"type": "file_json", "path": "config.json", "pointer": "/FEATURE_FLAGS", "equals": "search,waitlist", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/GREETING", "equals": "Welcome to \"Harbour\" Hotels", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/DATABASE_URL", "equals": "postgres://booking@db.internal:5432/booking", "lenient": false}
          ]
        },
        {
          "id": "R5",
          "text": "If a key appears more than once, the last occurrence wins (APP_PORT is 9090).",
          "checks": [
            {"type": "file_json", "path": "config.json", "pointer": "/APP_PORT", "equals": "9090", "lenient": false}
          ]
        },
        {
          "id": "R6",
          "text": "config.json maps each key to its value as a string (all values are JSON strings, not numbers).",
          "checks": [
            {"type": "file_json", "path": "config.json", "pointer": "/APP_PORT", "equals": "9090", "lenient": false},
            {"type": "file_json", "path": "config.json", "pointer": "/CACHE_TTL", "equals": "300 # seconds", "lenient": false},
            {"type": "file_regex", "path": "config.json", "pattern": "\"APP_PORT\"\\s*:\\s*\"9090\""}
          ]
        }
      ]
    },
