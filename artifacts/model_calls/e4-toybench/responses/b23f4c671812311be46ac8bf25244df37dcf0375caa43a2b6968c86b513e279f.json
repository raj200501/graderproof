    "397a1b4a70e65da0575d3f02756ca68237a352500b3e662d05a118999c6384e8": {
      "requirements": [
        {
          "id": "R1",
          "text": "Write a Python module sms.py with a function split_sms(message) returning the list of parts to send.",
          "checks": [
