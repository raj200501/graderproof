          ]
        },
        {
          "id": "R2",
          "text": "totals.csv has the header row customer,total, then one row per customer with the sum of that customer's payments, rows sorted by customer name (plain string comparison), each total with exactly two decimal places.",
          "checks": [
            {"type": "file_equals", "path": "totals.csv", "text": "customer,total\n\"Adventure Works, LLC\",600.00\nContoso Ltd,355.75\nFabrikam Inc,2399.95\nNorthwind Traders,1289.99\n", "normalize": "strip"}
          ]
