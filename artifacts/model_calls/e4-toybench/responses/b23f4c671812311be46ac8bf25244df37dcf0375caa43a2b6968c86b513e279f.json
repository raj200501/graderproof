            {"type": "call", "probe": {"function": "split_sms", "args": ["hello"], "kwargs": {}}, "equals": ["hello"]}
          ]
        },
        {
          "id": "R2",
          "text": "If message has at most 160 characters, return [message], including the empty message which returns [\"\"].",
          "checks": [
            {"type": "call", "probe": {"function": "split_sms", "args": [""], "kwargs": {}}, "equals": [""]},
            {"type": "call", "probe": {"function": "split_sms", "args": ["abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij"], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "split_sms", "args": ["abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijk"], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R3",
          "text": "Otherwise split into consecutive parts of exactly 153 characters, except the last part which holds the remaining 1 to 153 characters.",
          "checks": [
            {"type": "call", "probe": {"function": "split_sms", "args": ["abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijk"], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "split_sms", "args": [""], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "split_sms", "args": [""], "kwargs": {}}, "matches_reference": true}
          ]
        },
        {
          "id": "R4",
          "text": "Joining the parts in order must give back message exactly: do not strip, add, reorder, or change any character (whitespace at the edges of parts is preserved).",
          "checks": [
            {"type": "call", "probe": {"function": "split_sms", "args": ["  hi  "], "kwargs": {}}, "equals": ["  hi  "]},
            {"type": "call", "probe": {"function": "split_sms", "args": ["                                                                                                                                                                                         x y"], "kwargs": {}}, "matches_reference": true},
            {"type": "call", "probe": {"function": "split_sms", "args": ["line1\nline2\n\n"], "kwargs": {}}, "equals": ["line1\nline2\n\n"]}
          ]
