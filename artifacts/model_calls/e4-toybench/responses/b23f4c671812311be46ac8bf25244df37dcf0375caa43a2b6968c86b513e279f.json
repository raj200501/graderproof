    "243fa62ac001404072e80a8e986f7087ae71772f4cc22cb79eeca87958a3490a": {
      "requirements": [
        {
          "id": "R1",
          "text": "Write a Python module dupes.py providing duplicate_groups(files).",
          "checks": [
            {"type": "file_exists", "path": "dupes.py"}
          ]
        },
        {
          "id": "R2",
          "text": "Files with exactly equal contents are duplicates; return one group (sorted list of all paths) per content shared by two or more paths.",
          "checks": [
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"a": "x", "b": "x", "c": "y"}], "kwargs": {}}, "equals": [["a", "b"]]},
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"c": "x", "a": "x", "b": "x"}], "kwargs": {}}, "equals": [["a", "b", "c"]]},
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"a": "x", "b": "x ", "c": "X"}], "kwargs": {}}, "equals": []}
          ]
        },
        {
          "id": "R3",
          "text": "Contents that belong to only one path produce no group; if there are no duplicates return [].",
          "checks": [
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{}], "kwargs": {}}, "equals": []},
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"a": "1", "b": "2", "c": "3"}], "kwargs": {}}, "equals": []},
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"only": ""}], "kwargs": {}}, "equals": []}
          ]
        },
        {
          "id": "R4",
          "text": "Order the groups by their first path (each group is the sorted list of its paths).",
          "checks": [
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"b": "1", "a": "2", "c": "1", "d": "2"}], "kwargs": {}}, "equals": [["a", "d"], ["b", "c"]]},
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"z": "p", "y": "p", "m": "q", "n": "q", "a": "r", "b": "r"}], "kwargs": {}}, "equals": [["a", "b"], ["m", "n"], ["y", "z"]]},
            {"type": "call", "probe": {"function": "duplicate_groups", "args": [{"d/x": "", "a/y": "", "b": "k", "c": "k"}], "kwargs": {}}, "matches_reference": true}
          ]
        }
      ]
    },
    "29312a402338b433d7e61a9c3b2759341ae2a3ae69d83514cc6c6eee5b1679a7": {
      "requirements": [
        {
