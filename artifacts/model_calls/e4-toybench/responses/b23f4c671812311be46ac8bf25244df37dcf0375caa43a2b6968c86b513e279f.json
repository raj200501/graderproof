          ]
        },
        {
          "id": "R4",
          "text": "Totals are written with exactly two decimal places (for example 600.00).",
          "checks": [
            {"type": "file_regex", "path": "totals.csv", "pattern": "(?m)^(\"Adventure Works, LLC\"|Contoso Ltd|Fabrikam Inc|Northwind Traders),[0-9]+\\.[0-9]{2}[ \\t\\r]*$"}
