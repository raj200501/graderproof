    "4176dbee329d43014eec627e89f589169ed32fd103d1ad6f75dfaae92e2b085e": {
      "requirements": [
        {
          "id": "R1",
          "text": "For every .py file under src/ (including subdirectories), remove all spaces and tabs at the end of every line, and change nothing else (line order, indentation, blank lines, final-newline status preserved).",
          "checks": [
            {"type": "file_equals", "path": "src/app/__init__.py", "text": "\"\"\"Booking service application package.\"\"\"\n", "normalize": "none"},
            {"type": "file_equals", "path": "src/app/pricing.py", "text": "from decimal import Decimal\n\nTAX_RATE = Decimal(\"0.20\")\n\ndef gross(net):\n    \"\"\"Return the price including tax.\"\"\"\n    return (net * (1 + TAX_RATE)).quantize(Decimal(\"0.01\"))\n\n\ndef discount(price, percent):\n\treturn price * (100 - percent) / 100\n", "normalize": "none"},
            {"type": "file_equals", "path": "src/cli/main.py", "text": "import sys\n\nfrom app.pricing import gross\n\n\ndef main(argv):\n    for arg in argv[1:]:\n        print(gross(arg))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))", "normalize": "none"}
          ]
        },
        {
          "id": "R2",
          "text": "Keep whether or not each file ends with a newline (src/cli/main.py has no final newline and must still have none).",
          "checks": [
            {"type": "file_regex", "path": "src/cli/main.py", "pattern": "sys\\.argv\\)\\)\\Z"},
            {"type": "file_regex", "path": "src/app/pricing.py", "pattern": "/ 100\\n\\Z"}
          ]
        },
        {
          "id": "R3",
          "text": "Do not modify files under src/ that are not .py files (src/cli/notes.txt keeps its trailing space).",
          "checks": [
            {"type": "file_equals", "path": "src/cli/notes.txt", "text": "keep this trailing space \n", "normalize": "none"}
          ]
        },
        {
          "id": "R4",
