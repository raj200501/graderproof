            {"type": "file_json", "path": "products.json", "pointer": "/3/name", "equals": "Braided Cable, 2 m", "lenient": false}
          ]
        },
        {
          "id": "R4",
          "text": "price is a JSON number (for example 39.5 for 39.50), not a string.",
