          "id": "R6",
          "text": "The unit is chosen before rounding, so 1048575 bytes is '1024.0 KiB'.",
          "checks": [
            {"type": "call", "probe": {"function": "sizes.format_size", "args": [1048575], "kwargs": {}}, "equals": "1024.0 KiB"},
            {"type": "call", "probe": {"function": "sizes.format_size", "args": [1073741823], "kwargs": {}}, "equals": "1024.0 MiB"},
            {"type": "call", "probe": {"function": "sizes.format_size", "args": [1099511627775], "kwargs": {}}, "matches_reference": true}
