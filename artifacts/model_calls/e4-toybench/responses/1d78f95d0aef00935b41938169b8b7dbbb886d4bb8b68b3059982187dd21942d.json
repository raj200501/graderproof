            {"type": "file_json", "path": "products.json", "pointer": "", "equals": [
              {"sku": "A-100", "name": "Desk Lamp", "price": 24.99, "in_stock": true},
              {"sku": "A-101", "name": "Monitor Stand", "price": 39.5, "in_stock": false},
