          "checks": [
            {"type": "file_json", "path": "products.json", "pointer": "/0/sku", "equals": "A-100", "lenient": false},
            {"type": "file_json", "path": "products.json", "pointer": "/1/sku", "equals": "A-101", "lenient": false},
            {"type": "file_json", "path": "products.json", "pointer": "/2/sku", "equals": "B-200", "lenient": false},
