          "checks": [
            {"type": "file_equals", "path": "chat_redacted.txt", "text": "[09:14] Agent: Thanks for contacting Northwind support. Can I have the email on the account?\n[09:15] Customer: Sure, it's [email], or try [email] if that fails.\n[09:15] Agent: Thanks! I found the account under [email].\n[09:16] Customer: Great. Please don't write to old-address@example any more, that inbox is closed.\n[09:17] Agent: Noted. Replies come from [email] (or [email] for invoices).\n[09:18] Customer: Perfect, thanks. My colleague ([email]) may also call.\n", "normalize": "none"},
