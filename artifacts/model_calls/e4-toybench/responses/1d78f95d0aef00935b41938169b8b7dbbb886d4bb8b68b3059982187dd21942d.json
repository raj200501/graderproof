          ]
        },
        {
          "id": "R3",
          "text": "Text such as old-address@example, whose domain has only one label, is not an email address and stays as it is.",
          "checks": [{"type": "file_contains", "path": "chat_redacted.txt", "text": "old-address@example any more"}]
        },
        {
          "id": "R4",
          "text": "Leave chat.txt unchanged.",
          "checks": [
            {"type": "file_equals", "path": "chat.txt", "text": "[09:14] Agent: Thanks for contacting Northwind support. Can I have the email on the account?\n[09:15] Customer: Sure, it's jamie.lee+orders@mailbox.example, or try jamie_lee@work-mail.example.org if that fails.\n[09:15] Agent: Thanks! I found the account under jamie.lee+orders@mailbox.example.\n[09:16] Customer: Great. Please don't write to old-address@example any more, that inbox is closed.\n[09:17] Agent: Noted. Replies come from support@northwind.example (or billing@northwind.example for invoices).\n[09:18] Customer: Perfect, thanks. My colleague (r.okafor@partner.example.co.uk) may also call.\n", "normalize": "none"}
          ]
        }
      ]
    },
